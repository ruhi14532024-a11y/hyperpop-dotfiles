{
  "layer": "top",
  "position": "top",
  "height": 44,
  "spacing": 2,
  "passthrough": false,
  "fixed-center": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "network",
    "pulseaudio",
    "clock",
    "battery",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "all-outputs": true,
    "disable-scroll": false,
    "active-only": false
  },
  "tray": {
    "show-passive-items": true,
    "spacing": 10
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 2
  },
  "memory": {
    "format": " {used:0.1f}Gi",
    "interval": 5
  },
  "network": {
    "format-wifi": "{signalStrength}%",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰤭 Bağlı değil",
    "tooltip-format": "{ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },
  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": " muted",
    "format-icons": {
      "headphone": "",
      "default": [" ", " ", " "]
    },
    "on-click": "pavucontrol"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<span color='#f0dcbf' font='Lexend 16'><tt><small>{calendar}</small></tt></span>",
    "calendar": {
      "format": {
        "days": "<span weight='normal'>{}</span>",
        "months": "<span color='#f0dcbf'><b>{}</b></span>",
        "today": "<span color='#e07856' weight='700'><u>{}</u></span>",
        "weekdays": "<span color='#e8a04c'><b>{}</b></span>",
        "weeks": "<span color='#d9a441'><b>W{}</b></span>"
      },
      "mode": "month",
      "mode-mon-col": 1,
      "on-scroll": 1
    }
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span>{icon} </span>{capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "interval": 5,
    "format-icons": ["󰂎", "󰁼", "󰁿", "󰂁", "󰁹"],
    "tooltip": true
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout",
    "format": "⏻"
  }
}
